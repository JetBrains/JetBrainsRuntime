################################################################################

include CopyCommon.gmk
include Modules.gmk

$(CONF_DST_DIR)/sound.properties: $(TOPDIR)/src/java.desktop/share/conf/sound.properties
	$(call install-file)

TARGETS += $(CONF_DST_DIR)/sound.properties

################################################################################
#
# Copy property files from sun/print to LIB_DST_DIR
#
PSFONTPROPFILE_SRC_DIR := $(TOPDIR)/src/java.desktop/share/conf
PSFONTPROPFILE_SRCS := $(wildcard $(PSFONTPROPFILE_SRC_DIR)/psfont*.properties*)
PSFONTPROPFILE_TARGET_FILES := $(subst $(PSFONTPROPFILE_SRC_DIR),$(LIB_DST_DIR),$(PSFONTPROPFILE_SRCS))

$(LIB_DST_DIR)/%: $(PSFONTPROPFILE_SRC_DIR)/%
	$(call install-file)

TARGETS += $(PSFONTPROPFILE_TARGET_FILES)

################################################################################
#
# Copy and filter the legal files depending on what 3rd party components are
# bundled or linked from the OS.
#
ifeq ($(USE_EXTERNAL_LIBJPEG), true)
  LEGAL_EXCLUDES += jpeg.md
endif

ifeq ($(USE_EXTERNAL_LIBGIF), true)
  LEGAL_EXCLUDES += giflib.md
endif

ifeq ($(USE_EXTERNAL_LIBPNG), true)
  LEGAL_EXCLUDES += libpng.md
endif

ifeq ($(USE_EXTERNAL_LCMS), true)
  LEGAL_EXCLUDES += lcms.md
endif

ifeq ($(FREETYPE_TO_USE), system)
  LEGAL_EXCLUDES += freetype.md
endif

ifeq ($(USE_EXTERNAL_HARFBUZZ), true)
  LEGAL_EXCLUDES += harfbuzz.md
endif

$(eval $(call SetupCopyLegalFiles, COPY_LEGAL, \
    EXCLUDES := $(LEGAL_EXCLUDES), \
))

TARGETS += $(COPY_LEGAL)

################################################################################
# Skia's ICU data on Windows. Skia's Unicode module (the shaper's bidi and script
# runs, SkUnicodes::ICU) loads icudtl.dat from the directory of the module that
# holds it (SkLoadICU), which is bin on Windows; without it the shaper and the
# paragraph engine are unavailable and Skia's text path is not taken. The file
# goes into the module's commands, which the image places in bin unconditionally
# (module libraries other than DLLs land in lib).

ifeq ($(call isTargetOs, windows)+$(SKIA_ENABLED), true+true)
  ifneq ($(wildcard $(SKIA_LIB_DIR)/icudtl.dat), )
    $(eval $(call SetupCopyFiles, COPY_SKIA_ICU_DATA, \
        FILES := $(SKIA_LIB_DIR)/icudtl.dat, \
        DEST := $(SUPPORT_OUTPUTDIR)/modules_cmds/java.desktop, \
    ))

    TARGETS += $(COPY_SKIA_ICU_DATA)
  endif
endif

################################################################################

FONTFILE_SRC_DIR := $(TOPDIR)/src/java.desktop/share
FONTFILE_SRCS := $(wildcard $(FONTFILE_SRC_DIR)/fonts/*.ttf) $(wildcard $(FONTFILE_SRC_DIR)/fonts/*.otf) $(FONTFILE_SRC_DIR)/fonts/fonts.dir $(FONTFILE_SRC_DIR)/fonts/font.conf
FONTFILE_TARGET_FILES := $(subst $(FONTFILE_SRC_DIR),$(LIB_DST_DIR),$(FONTFILE_SRCS))

$(LIB_DST_DIR)/fonts/%: $(FONTFILE_SRC_DIR)/fonts/%
	$(call install-file)


TARGETS += $(FONTFILE_TARGET_FILES)
